(* -*- mode: sml -*- *)
_require "basis.smi"
structure Token =
struct
  datatype token
    = EOF | UNDERBAR | ID of string | STRING of string
      | REAL of string | INT of string | SPECIAL of string
      | CONSTINT of string
      | KW_ANDALSO
      | KW_AND
      | KW_AS
      | KW_CASE
      | KW_DO
      | KW_ELSE
      | KW_END
      | KW_EXCEPTION
      | KW_FN
      | KW_FUN
      | KW_HANDLE
      | KW_IF
      | KW_IN
      | KW_INFIX
      | KW_INFIXR
      | KW_NONFIX
      | KW_LET
      | KW_LOCAL
      | KW_OF
      | KW_OP
      | KW_OPEN
      | KW_ORELSE
      | KW_RAISE
      | KW_REC
      | KW_THEN
      | KW_USE
      | KW_VAL
      | KW_WHILE
      | SYM_COMMA
      | SYM_DOTS
      | SYM_PERIOD
      | SYM_COLON
      | SYM_SEMICOLON
      | SYM_DARROW
      | SYM_EQ
      | SYM_LBRACKET
      | SYM_RBRACKET
      | SYM_BAR
  val toString : token -> string
end
